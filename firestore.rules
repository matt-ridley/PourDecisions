rules_version = '2';
// Pour Decisions. Nothing is readable unless you are a signed-in, non-paused member of the group.
// config/group is created once by whoever sets up the group ("claiming" it); they become owner and admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function groupPath() { return /databases/$(database)/documents/config/group; }
    function memberPath(id) { return /databases/$(database)/documents/members/$(id); }
    function group() { return get(groupPath()).data; }
    function isMember() {
      return signedIn() && exists(memberPath(me())) && get(memberPath(me())).data.suspended != true;
    }
    function isAdmin() { return isMember() && me() in group().admins; }
    function isOwner() { return signedIn() && group().ownerUid == me(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function cleanName(n) { return n is string && n.size() > 0 && n.size() <= 40; }
    function optText(d, f, max) { return !(f in d) || (d[f] is string && d[f].size() <= max); }

    match /config/group {
      // Signed-in users can see whether a group exists (to show "Start" or "Join"); it holds no secrets.
      allow get: if signedIn();
      // Claiming: only while it doesn't exist, and only for yourself.
      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.admins == [me()]
        && cleanName(request.resource.data.name)
        && request.resource.data.keys().hasOnly(["name", "ownerUid", "admins", "createdAt"]);
      // Admins may rename it. Only the owner may change who the admins are, and the owner always stays an admin.
      allow update: if isAdmin()
        && changed().hasOnly(["name", "admins"])
        && cleanName(request.resource.data.name)
        && (!changed().hasAny(["admins"]) || (isOwner() && resource.data.ownerUid in request.resource.data.admins));
    }

    match /config/invite {
      allow get: if isAdmin();
      // Created by the owner while claiming (same batch), then changed by admins.
      allow create: if signedIn() && getAfter(groupPath()).data.ownerUid == me() && request.resource.data.code is string;
      allow update: if isAdmin() && request.resource.data.code is string && request.resource.data.code.size() >= 4;
    }

    match /members/{id} {
      allow get: if isMember() || (signedIn() && id == me());
      allow list: if isMember();
      allow create: if signedIn() && id == me()
        && cleanName(request.resource.data.displayName)
        && request.resource.data.suspended == false
        && (
          // The owner, while claiming the group.
          (getAfter(groupPath()).data.ownerUid == me() && !request.resource.data.keys().hasAny(["invite"]))
          // Everyone else: the invite code must match.
          || (exists(/databases/$(database)/documents/config/invite)
              && request.resource.data.invite == get(/databases/$(database)/documents/config/invite).data.code)
        );
      // Your own profile, but you can't un-pause yourself or bring back an invite code.
      allow update: if (signedIn() && id == me() && !changed().hasAny(["suspended", "joinedAt"])
                         && !request.resource.data.keys().hasAny(["invite"])
                         && cleanName(request.resource.data.displayName)
                         && optText(request.resource.data, "hometown", 60)
                         && optText(request.resource.data, "favourite", 60)
                         && (!("avatar" in request.resource.data) || request.resource.data.avatar == null
                             || (request.resource.data.avatar is string && request.resource.data.avatar.size() < 120000)))
        // Admins can pause or un-pause; only the owner can do that to another admin. Nobody can pause the owner.
        || (isAdmin() && changed().hasOnly(["suspended"]) && id != group().ownerUid
            && (!(id in group().admins) || isOwner()));
      allow delete: if isAdmin() && id != group().ownerUid && id != me() && (!(id in group().admins) || isOwner());
    }

    // ---------- Drink logs ----------
    // Times are phone-clock epoch ms. A log can't be dated in the future (10 minutes of clock slack), or before 2020.
    // uid is who drank it. madeBy is who made it, when someone made a cocktail for someone else: they log it for them.
    // variantId points at the cocktail variant made (variants below); drinkId stays the original cocktail.
    function logOk(d) {
      return d.keys().hasOnly(["uid", "kind", "drinkId", "title", "style", "size", "ml", "abv", "at", "createdAt", "editedAt",
                               "rating", "notes", "tags", "placeId", "hasPhoto", "variantId", "madeBy", "offFeed"])
        && d.kind in ["drink", "cocktail"]
        && d.drinkId is string && d.drinkId.size() > 0 && d.drinkId.size() <= 80
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.style is string && d.style.size() <= 40
        && d.size is string && d.size.size() <= 20
        && d.ml is number && d.ml > 0 && d.ml <= 5000
        && d.abv is number && d.abv >= 0 && d.abv <= 100
        && d.at is int && d.at > 1577836800000 && d.at <= request.time.toMillis() + 600000
        && d.createdAt is int
        && d.hasPhoto is bool
        && (!("rating" in d) || (d.rating is number && d.rating >= 0.5 && d.rating <= 5 && math.floor(d.rating * 2) == d.rating * 2))
        && optText(d, "notes", 500)
        && (!("tags" in d) || (d.tags is list && d.tags.size() <= 5))
        && optText(d, "placeId", 40)
        && (!("offFeed" in d) || d.offFeed is bool)
        && (!("variantId" in d) || (d.kind == "cocktail" && d.variantId is string && d.variantId.size() > 0 && d.variantId.size() <= 120))
        && (!("editedAt" in d) || d.editedAt is int);
    }

    match /logs/{id} {
      allow read: if isMember();
      // Your own drink, or one you made for another member (madeBy is you).
      allow create: if isMember() && logOk(request.resource.data) && !("editedAt" in request.resource.data)
        && (("madeBy" in request.resource.data)
            ? request.resource.data.madeBy == me() && request.resource.data.uid != me() && exists(memberPath(request.resource.data.uid))
            : request.resource.data.uid == me());
      // The drinker edits it; who drank it and who made it never change.
      allow update: if isMember() && resource.data.uid == me() && logOk(request.resource.data)
        && !changed().hasAny(["uid", "createdAt", "madeBy"]);
      // Your own, one you made for someone, or anyone's for an admin.
      allow delete: if isMember() && (resource.data.uid == me() || resource.data.get("madeBy", "") == me() || isAdmin());
    }

    // ---------- Ratings: one per person per drink (doc id = uid_kind_drinkId) ----------
    // Stars are required; flavour tags and a review are optional. Logs from before 0.8.0 may still hold a rating and
    // tags (allowed above so they stay editable); the app counts those until the drink is rated here.
    function ratingOk(id, d) {
      return d.keys().hasOnly(["uid", "kind", "drinkId", "title", "rating", "tags", "review", "at"])
        && d.uid == me()
        && d.kind in ["drink", "cocktail", "variant"]
        && d.drinkId is string && d.drinkId.size() > 0 && d.drinkId.size() <= (d.kind == "variant" ? 120 : 80)
        && id == me() + "_" + d.kind + "_" + d.drinkId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.rating is number && d.rating >= 0.5 && d.rating <= 5 && math.floor(d.rating * 2) == d.rating * 2
        && (!("tags" in d) || (d.tags is list && d.tags.size() <= 5))
        && optText(d, "review", 500)
        && d.at is int;
    }
    match /ratings/{id} {
      allow read: if isMember();
      allow create: if isMember() && ratingOk(id, request.resource.data);
      allow update: if isMember() && (
        (resource.data.uid == me() && ratingOk(id, request.resource.data))
        // Admins can take down someone's review text (their stars and flavours stay).
        || (isAdmin() && changed().hasOnly(["review"]) && !("review" in request.resource.data)));
      allow delete: if isMember() && resource.data.uid == me();
    }

    // A log's photos live in their own documents (same id as the log), so opening the app never downloads them all.
    function picOk(d, max) {
      return d.keys().hasOnly(["uid", "src", "at", "bytes"]) && d.uid == me()
        && d.src is string && d.src.size() <= max && d.src.matches("data:image/jpeg;base64,.*")
        && d.at is int && d.bytes is int;
    }
    match /thumbs/{id} {
      allow get: if isMember();
      allow create, update: if isMember() && picOk(request.resource.data, 80000) && (resource == null || resource.data.uid == me());
      // Deleting one that isn't there is fine (a log's batch delete always includes its photos).
      allow delete: if isMember() && (resource == null || resource.data.uid == me() || isAdmin());
    }
    match /photos/{id} {
      allow get: if isMember();
      allow create, update: if isMember() && picOk(request.resource.data, 600000) && (resource == null || resource.data.uid == me());
      allow delete: if isMember() && (resource == null || resource.data.uid == me() || isAdmin());
    }

    // ---------- Shared places and drinks members add ----------
    match /places/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(["name", "by", "at"])
        && request.resource.data.by == me()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.at is int;
      // Tidying up is for admins: renaming, and merging a duplicate into the place to keep (mergedInto).
      allow update: if isAdmin() && changed().hasOnly(["name", "mergedInto"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && optText(request.resource.data, "mergedInto", 40);
      allow delete: if isAdmin();
    }

    function memberDrinkOk(d) {
      return d.keys().hasOnly(["brand", "name", "variant", "style", "abv", "origin", "by", "at", "checked", "ing", "mergedInto"])
        && d.brand is string && d.brand.size() > 0 && d.brand.size() <= 60
        && d.name is string && d.name.size() <= 80
        && optText(d, "variant", 40) && optText(d, "origin", 10)
        && d.style is string && d.style.size() > 0 && d.style.size() <= 40
        && d.abv is number && d.abv >= 0 && d.abv <= 80
        && d.at is int
        && (!("checked" in d) || d.checked is bool)
        && (!("ing" in d) || (d.ing is list && d.ing.size() <= 10))
        && optText(d, "mergedInto", 80);
    }
    match /drinks/{id} {
      allow read: if isMember();
      // Members add drinks; the moderation fields (checked, ing, mergedInto) are for admins.
      allow create: if isMember() && memberDrinkOk(request.resource.data) && request.resource.data.by == me()
        && !request.resource.data.keys().hasAny(["checked", "ing", "mergedInto"]);
      // Fixing details is for admins (catalogue moderation); who added it never changes.
      allow update: if isAdmin() && memberDrinkOk(request.resource.data) && !changed().hasAny(["by", "at"]);
      allow delete: if isAdmin();
    }

    // ---------- Cocktail variants: members' own takes on a recipe (see js/variants.js) ----------
    // The id is the original cocktail's id, "~", then a hash of what's in it, so the same drink made twice is one variant.
    // Saved once: after that the maker can rename it, and admins can rename it or merge a duplicate (mergedInto).
    function variantOk(id, d) {
      return d.keys().hasOnly(["base", "from", "name", "by", "at", "glass", "garnish", "ingredients", "mergedInto"])
        && d.base is string && d.base.size() > 0 && d.base.size() <= 80
        && id.size() <= 120 && id.matches("[a-z0-9-]+~[a-z0-9]+") && id.split("~")[0] == d.base
        && (!("name" in d) || cleanName(d.name))
        && d.by is string && d.at is int
        && optText(d, "from", 120) && optText(d, "glass", 40) && optText(d, "garnish", 80)
        && d.ingredients is list && d.ingredients.size() > 0 && d.ingredients.size() <= 20
        && optText(d, "mergedInto", 120);
    }
    match /variants/{id} {
      allow read: if isMember();
      allow create: if isMember() && variantOk(id, request.resource.data) && request.resource.data.by == me()
        && !("mergedInto" in request.resource.data);
      allow update: if isMember() && variantOk(id, request.resource.data) && (
        (resource.data.by == me() && changed().hasOnly(["name"]))
        || (isAdmin() && changed().hasOnly(["name", "mergedInto"])));
      allow delete: if isAdmin();
    }

    // ---------- Cheers and comments on feed posts ----------
    // A post id names what's cheered: s~<log> (a night), r~<rating>, v~<variant>, h~<variant>, a~<drink>,
    // n~<log> (a night recap), f~<log>_<what> (a first or milestone).
    // `to` is whoever the post is about, for their alerts.
    function postOk(p) { return p is string && p.size() > 2 && p.size() <= 160 && p.matches("[srvhanf]~.+"); }
    match /cheers/{id} {
      allow read: if isMember();
      // One per person per post (id = post|uid); taken back by deleting it.
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(["post", "uid", "to", "at"])
        && request.resource.data.uid == me() && postOk(request.resource.data.post)
        && id == request.resource.data.post + "|" + me()
        && request.resource.data.to is string && request.resource.data.to.size() <= 128
        && request.resource.data.at is int;
      allow delete: if isMember() && resource.data.uid == me();
    }
    match /comments/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(["post", "uid", "to", "text", "at"])
        && request.resource.data.uid == me() && postOk(request.resource.data.post)
        && request.resource.data.to is string && request.resource.data.to.size() <= 128
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.at is int;
      // No editing. Your own, or anyone's for an admin.
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin());
    }

    // ---------- Catalogue moderation ----------
    // Corrections to built-in drinks (doc id = the built-in drink's id), laid over the list by the app. Only the
    // fields that differ are stored. mergedInto points a duplicate at the drink to keep.
    match /fixes/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["brand", "name", "variant", "style", "abv", "approx", "origin", "town", "ing", "mergedInto", "by", "at"])
        && request.resource.data.by == me() && request.resource.data.at is int
        && optText(request.resource.data, "brand", 60) && optText(request.resource.data, "name", 80)
        && optText(request.resource.data, "variant", 40) && optText(request.resource.data, "style", 40)
        && optText(request.resource.data, "origin", 10) && optText(request.resource.data, "town", 60)
        && optText(request.resource.data, "mergedInto", 80)
        && (!("abv" in request.resource.data) || (request.resource.data.abv is number && request.resource.data.abv >= 0 && request.resource.data.abv <= 80))
        && (!("approx" in request.resource.data) || request.resource.data.approx is bool)
        && (!("ing" in request.resource.data) || (request.resource.data.ing is list && request.resource.data.ing.size() <= 10));
      allow delete: if isAdmin();
    }

    // Admins' styles: a built-in style's id renames it or rewrites its description; any other id is a new style
    // under an existing family ("cat/fam").
    match /styles/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["name", "about", "family", "by", "at"])
        && request.resource.data.by == me() && request.resource.data.at is int
        && (!("name" in request.resource.data) || cleanName(request.resource.data.name))
        && optText(request.resource.data, "about", 200) && optText(request.resource.data, "family", 60)
        && id.size() <= 40;
      allow delete: if isAdmin();
    }
  }
}
